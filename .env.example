# Copy to .env and adjust. NEVER commit .env.
#
# Do not copy ED360's .env across — it contains that system's JWT secret and
# database credentials, and reusing a secret across two systems means a
# compromise of one forges tokens for the other.

ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Set DATABASE_URL to point at a hosted Postgres (e.g. Neon) — it overrides
# DB_HOST/PORT/NAME/USER/PASSWORD entirely. Leave blank for local dev, where
# the individual DB_* fields below are used instead.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/ignition?sslmode=require

# 5433 on the host: ED360's postgres already holds 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ignition
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5
DB_ECHO=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Leave blank in development and one is generated per process (tokens won't
# survive a restart, which is fine locally). REQUIRED in production — at least
# 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis ─────────────────────────────────────────────────────────────────────
# Set REDIS_URL to point at a managed Redis (e.g. Render Key Value) — it
# overrides REDIS_HOST/PORT/DB entirely. Leave blank for local dev.
# REDIS_URL=redis://red-xxxx:6379

# 6380 on the host: ED360's redis already holds 6379.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Media (avatars, documents, leave attachments) is uploaded straight to
# Cloudinary — see app/core/uploads.py. Required in production; the test suite
# never calls Cloudinary so these can stay blank there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── HTTP ──────────────────────────────────────────────────────────────────────
# 5174 = admin dashboard (Vite), 3000 = student portal (CRA).
# In production, replace with the deployed frontend origins, e.g.
# CORS_ORIGINS=["https://ignition-admin.onrender.com","https://ignition-student.onrender.com"]
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost:3000","http://127.0.0.1:3000"]

MAX_UPLOAD_SIZE_MB=25

# ── Docker compose host port mappings ─────────────────────────────────────────
API_PORT=8001
